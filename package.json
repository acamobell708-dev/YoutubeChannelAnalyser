{
  "name": "youtube-video-analyser-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React and Node.js dashboard for analysing YouTube video engagement and comments.",
  "scripts": {
    "build": "npm run build:client",
    "build:client": "esbuild public/client/VideoDashboard.jsx public/client/ChannelDashboard.jsx --bundle --minify --sourcemap --outdir=public/assets --entry-names=[name]",
    "dev": "npm run build:client && node --watch src/server.js",
    "start": "npm run build:client && node src/server.js",
    "test": "node --test --test-isolation=none"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "openai": "^5.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.8",
    "supertest": "^7.1.4"
  }
}
