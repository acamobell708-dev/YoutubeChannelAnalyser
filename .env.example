# Copy this file to .env and replace both placeholder values.
YOUTUBE_API_KEY=replace_with_your_youtube_api_key
OPENAI_API_KEY=replace_with_your_openai_api_key
# Optional: Organisation Admin key used to include account-wide current-day usage.
# Without it, the daily cap is enforced against requests made by this application.
OPENAI_ADMIN_KEY=
OPENAI_VIDEO_MODEL=gpt-5.4
OPENAI_CHANNEL_MODEL=gpt-5.4

# Optional Phase 2 owner authentication. Keep these values server-side.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=https://adam-cloud-storage-app-2026.wittybay-03ca85b1.uksouth.azurecontainerapps.io
SESSION_SECRET=generate_a_random_secret_of_at_least_32_characters

PORT=3000
